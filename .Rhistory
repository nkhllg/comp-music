add_model(knn_model) |>
tune_grid(compmus_cv, grid = knn_grid, control = control_grid(save_pred = TRUE))
classification_knn |> collect_metrics() |> arrange(desc(mean))
best_k <- classification_knn |> select_best(metric = "accuracy")
best_k
final_knn <-
classification_knn |>
extract_workflow() |>
finalize_workflow(best_k) |>
fit(compmus2025_filtered)
